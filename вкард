<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111111">

  <title>YOUR NAME — Digital Business Card</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f4f4f2;
      color: #111;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                   Roboto, Helvetica, Arial, sans-serif;
    }

    .container {
      width: 100%;
      max-width: 560px;
      min-height: 100vh;
      margin: auto;
      padding: 45px 22px 35px;
      display: flex;
      flex-direction: column;
    }

    /* PROFILE */

    .profile {
      text-align: center;
    }

    .avatar {
      width: 96px;
      height: 96px;
      margin: 0 auto 22px;

      border-radius: 50%;
      background: #111;
      color: white;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 28px;
      font-weight: 700;
    }

    h1 {
      margin: 0;
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -0.7px;
    }

    .position {
      margin-top: 8px;
      color: #777;
      font-size: 15px;
    }

    .description {
      max-width: 420px;
      margin: 18px auto 0;

      color: #555;
      font-size: 14px;
      line-height: 1.55;
    }

    /* SECTIONS */

    .section-title {
      margin: 35px 0 12px;

      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #999;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* BUTTONS */

    .link {
      display: flex;
      align-items: center;
      justify-content: center;

      min-height: 54px;

      background: white;
      color: #111;

      border: 1px solid #e5e5e5;
      border-radius: 14px;

      text-decoration: none;
      font-size: 15px;
      font-weight: 500;

      transition: all 0.2s ease;
    }

    .link:hover {
      transform: translateY(-2px);
      box-shadow: 0 7px 20px rgba(0,0,0,0.07);
    }

    /* SAVE CONTACT */

    .save-contact {
      display: flex;
      align-items: center;
      justify-content: center;

      min-height: 56px;
      margin-top: 25px;

      background: #111;
      color: white;

      border-radius: 14px;

      text-decoration: none;
      font-size: 15px;
      font-weight: 700;

      transition: all 0.2s ease;
    }

    .save-contact:hover {
      background: #222;
      transform: translateY(-2px);
    }

    /* FOOTER */

    footer {
      margin-top: auto;
      padding-top: 45px;

      text-align: center;

      color: #aaa;
      font-size: 11px;
    }

    /* MOBILE */

    @media (max-width: 400px) {

      .container {
        padding: 35px 17px 30px;
      }

      h1 {
        font-size: 27px;
      }

      .avatar {
        width: 86px;
        height: 86px;
      }
    }
  </style>
</head>


<body>

<div class="container">

  <!-- PROFILE -->

  <div class="profile">

    <div class="avatar">
      YN
    </div>

    <h1>
      YOUR NAME
    </h1>

    <div class="position">
      Founder / CEO · COMPANY
    </div>

    <div class="description">
      Краткое описание о вас, вашей компании
      или вашей деятельности.
    </div>

  </div>


  <!-- CONTACT -->

  <div class="section-title">
    CONTACT
  </div>

  <div class="links">

    <a
      class="link"
      href="tel:+00000000000">
      📞 Call
    </a>

    <a
      class="link"
      href="https://wa.me/00000000000"
      target="_blank">
      💬 WhatsApp
    </a>

    <a
      class="link"
      href="https://t.me/USERNAME"
      target="_blank">
      ✈️ Telegram
    </a>

    <a
      class="link"
      href="mailto:email@example.com">
      ✉️ Email
    </a>

  </div>


  <!-- SAVE CONTACT -->

  <a
    class="save-contact"
    href="contact.vcf">
    ＋ Save Contact
  </a>


  <!-- LINKS -->

  <div class="section-title">
    LINKS
  </div>

  <div class="links">

    <a
      class="link"
      href="https://example.com"
      target="_blank">
      🌐 Website
    </a>

    <a
      class="link"
      href="https://instagram.com/USERNAME"
      target="_blank">
      ◎ Instagram
    </a>

    <a
      class="link"
      href="https://linkedin.com/in/USERNAME"
      target="_blank">
      in LinkedIn
    </a>

    <a
      class="link"
      href="https://example.com/catalog"
      target="_blank">
      ▣ Catalog
    </a>

  </div>


  <footer>
    Digital Business Card
  </footer>

</div>

</body>
</html>
